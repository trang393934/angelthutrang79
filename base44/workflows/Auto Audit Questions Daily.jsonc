{
  "name": "Auto Audit Questions Daily",
  "description": "T\u1ef1 \u0111\u1ed9ng audit t\u1ea5t c\u1ea3 c\u00e2u h\u1ecfi m\u1edbi m\u1ed7i ng\u00e0y l\u00fac 2h s\u00e1ng \u0111\u1ec3 ph\u00e2n lo\u1ea1i duplicate, greeting, c\u00e2u 11+ v\u00e0 \u00e1p d\u1ee5ng h\u00e0nh \u0111\u1ed9ng t\u01b0\u01a1ng \u1ee9ng",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 19 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_audit_questions_daily",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "comprehensiveAudit",
            "args": {
              "audit_all": true,
              "batch_size": 20
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "comprehensiveAudit"
  }
}