{
  "name": "UserPersonalityProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email c\u1ee7a ng\u01b0\u1eddi d\u00f9ng"
    },
    "communication_style": {
      "type": "string",
      "description": "Phong c\u00e1ch giao ti\u1ebfp (formal/casual/emotional/direct)"
    },
    "emotional_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "C\u00e1c pattern c\u1ea3m x\u00fac th\u01b0\u1eddng g\u1eb7p"
    },
    "life_challenges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "C\u00e1c th\u00e1ch th\u1ee9c cu\u1ed9c s\u1ed1ng \u0111ang g\u1eb7p ph\u1ea3i"
    },
    "spiritual_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "C\u00e1c ch\u1ee7 \u0111\u1ec1 t\u00e2m linh quan t\u00e2m"
    },
    "personality_traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0110\u1eb7c \u0111i\u1ec3m t\u00ednh c\u00e1ch"
    },
    "current_mood": {
      "type": "string",
      "description": "T\u00e2m tr\u1ea1ng hi\u1ec7n t\u1ea1i"
    },
    "conversation_memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "insight": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "description": "Nh\u1eefng \u0111i\u1ec1u quan tr\u1ecdng t\u1eeb c\u00e1c cu\u1ed9c tr\u00f2 chuy\u1ec7n"
    },
    "response_preferences": {
      "type": "object",
      "properties": {
        "length": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "detailed"
          ]
        },
        "emotional_support_level": {
          "type": "string",
          "enum": [
            "gentle",
            "moderate",
            "strong"
          ]
        },
        "use_metaphors": {
          "type": "boolean"
        }
      },
      "description": "Preferences v\u1ec1 c\u00e1ch AI tr\u1ea3 l\u1eddi"
    },
    "last_analyzed": {
      "type": "string",
      "format": "date-time",
      "description": "L\u1ea7n ph\u00e2n t\u00edch cu\u1ed1i c\u00f9ng"
    }
  },
  "required": [
    "user_email"
  ]
}