{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Conversation title"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "description": "Chat messages in the conversation"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this conversation is marked as favorite"
    }
  },
  "required": [
    "title",
    "messages"
  ]
}