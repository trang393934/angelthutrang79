{
  "name": "DailyWithdrawalLimit",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email ng\u01b0\u1eddi d\u00f9ng"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Ng\u00e0y (YYYY-MM-DD)"
    },
    "total_withdrawn_today": {
      "type": "number",
      "default": 0,
      "description": "T\u1ed5ng s\u1ed1 Camlycoin \u0111\u00e3 r\u00fat trong ng\u00e0y"
    },
    "withdrawal_count": {
      "type": "number",
      "default": 0,
      "description": "S\u1ed1 l\u1ea7n r\u00fat trong ng\u00e0y"
    }
  },
  "required": [
    "user_email",
    "date"
  ],
  "rls": {}
}