{
  "name": "DailyPractice",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Ng\u00e0y c\u1ee7a b\u00e0i th\u1ef1c h\u00e0nh (YYYY-MM-DD)"
    },
    "title": {
      "type": "string",
      "description": "Ti\u00eau \u0111\u1ec1 b\u00e0i th\u1ef1c h\u00e0nh"
    },
    "content": {
      "type": "string",
      "description": "N\u1ed9i dung h\u01b0\u1edbng d\u1eabn chi ti\u1ebft"
    },
    "practice_type": {
      "type": "string",
      "enum": [
        "breathing",
        "mindfulness",
        "gratitude",
        "mantra",
        "visualization",
        "body_scan"
      ],
      "default": "breathing",
      "description": "Lo\u1ea1i th\u1ef1c h\u00e0nh"
    },
    "duration_minutes": {
      "type": "number",
      "default": 10,
      "description": "Th\u1eddi gian th\u1ef1c h\u00e0nh \u0111\u1ec1 xu\u1ea5t (ph\u00fat)"
    },
    "quote": {
      "type": "string",
      "description": "C\u00e2u tr\u00edch d\u1eabn truy\u1ec1n c\u1ea3m h\u1ee9ng"
    }
  },
  "required": [
    "date",
    "title",
    "content",
    "practice_type"
  ]
}