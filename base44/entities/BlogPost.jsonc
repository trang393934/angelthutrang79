{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Ti\u00eau \u0111\u1ec1 b\u00e0i vi\u1ebft"
    },
    "content": {
      "type": "string",
      "description": "N\u1ed9i dung b\u00e0i vi\u1ebft (markdown)"
    },
    "excerpt": {
      "type": "string",
      "description": "M\u00f4 t\u1ea3 ng\u1eafn g\u1ecdn"
    },
    "topic": {
      "type": "string",
      "description": "Ch\u1ee7 \u0111\u1ec1 g\u1ed1c \u0111\u1ec3 t\u1ea1o b\u00e0i"
    },
    "tone": {
      "type": "string",
      "enum": [
        "professional",
        "friendly",
        "casual",
        "formal",
        "inspiring",
        "poetic"
      ],
      "default": "friendly",
      "description": "Gi\u1ecdng \u0111i\u1ec7u"
    },
    "style": {
      "type": "string",
      "enum": [
        "informative",
        "storytelling",
        "persuasive",
        "educational",
        "conversational"
      ],
      "default": "informative",
      "description": "V\u0103n phong"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags t\u1ef1 \u0111\u1ed9ng t\u1ea1o b\u1edfi AI"
    },
    "meta_description": {
      "type": "string",
      "description": "Meta description cho SEO"
    },
    "meta_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Meta keywords cho SEO"
    },
    "featured_image_url": {
      "type": "string",
      "description": "URL \u1ea3nh \u0111\u1ea1i di\u1ec7n"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Tr\u1ea1ng th\u00e1i b\u00e0i vi\u1ebft"
    },
    "read_time_minutes": {
      "type": "number",
      "description": "Th\u1eddi gian \u0111\u1ecdc \u01b0\u1edbc t\u00ednh (ph\u00fat)"
    },
    "category": {
      "type": "string",
      "description": "Danh m\u1ee5c b\u00e0i vi\u1ebft"
    },
    "word_count": {
      "type": "number",
      "description": "S\u1ed1 t\u1eeb trong b\u00e0i"
    }
  },
  "required": [
    "title",
    "content",
    "topic"
  ]
}