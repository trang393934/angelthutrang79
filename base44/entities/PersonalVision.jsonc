{
  "name": "PersonalVision",
  "type": "object",
  "properties": {
    "input_thoughts": {
      "type": "string",
      "description": "User's initial thoughts and goals"
    },
    "vision_statement": {
      "type": "string",
      "description": "AI-generated personal vision statement"
    },
    "core_values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Core values aligned with user's vision"
    },
    "action_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested steps to manifest the vision"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the current active vision"
    }
  },
  "required": [
    "input_thoughts",
    "vision_statement"
  ]
}